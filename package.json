{
  "name": "ng-brutalism",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "analytics:report": "tsx tools/analytics-report/src/index.ts",
    "build:ui": "nx build ui",
    "build:docs": "nx run docs:build-seo-artifacts && pnpm validate:docs-routes",
    "format:docs": "nx run docs:format",
    "format:docs:check": "nx run docs:format-check",
    "validate:docs-routes": "node apps/docs/scripts/validate-public-routes.mjs",
    "e2e:docs": "nx e2e docs",
    "serve:docs": "nx serve docs",
    "sync:repo-metadata": "node scripts/sync-repository-metadata.mjs",
    "smoke:ui:ng22": "node tools/package-smoke/run.mjs --ng=22",
    "min-version-check": "node tools/min-version-check/run.mjs",
    "forms-contract-check": "tsc -p libs/ui/tsconfig.forms-contract.json",
    "api-export-check": "node tools/api-export-check/run.mjs",
    "api-guard": "node tools/api-export-check/run.mjs && node tools/api-guard/run.mjs",
    "api-guard:update": "node tools/api-export-check/run.mjs && node tools/api-guard/run.mjs --update",
    "docs:tokens:check": "node apps/docs/scripts/generate-token-reference.mjs",
    "docs:tokens:update": "node apps/docs/scripts/generate-token-reference.mjs --update",
    "test": "nx affected --target=test",
    "lint": "nx affected --target=lint"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "2.6.3",
    "@analogjs/router": "2.6.3",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@angular/platform-browser-dynamic": "22.0.6",
    "@angular/platform-server": "22.0.6",
    "@angular/router": "22.0.6",
    "@angular/ssr": "22.0.6",
    "ol": "^10.9.0",
    "rxjs": "~7.8.0",
    "shiki": "^1.29.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "2.6.3",
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular-devkit/build-angular": "22.0.6",
    "@angular-devkit/core": "22.0.6",
    "@angular-devkit/schematics": "22.0.6",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@oxc-project/runtime": "^0.121.0",
    "@playwright/test": "1.60.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "4.1.6",
    "angular-eslint": "22.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-playwright": "1.8.3",
    "jiti": "2.4.2",
    "jsdom": "^29.1.1",
    "ng-packagr": "22.0.1",
    "nx": "23.1.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.33.1",
    "vite": "8.1.4",
    "vitest": "4.1.6",
    "vitest-axe": "1.0.0-pre.5"
  },
  "nx": {
    "includedScripts": [
      "analytics:report"
    ]
  }
}
