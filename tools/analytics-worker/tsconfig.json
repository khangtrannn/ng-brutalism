{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
