{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "exclude": [
    "src/**/*.spec.ts",
    "jest.config.ts",
    "src/**/*.test.ts",
    "tokens/src/**/*.spec.ts",
    "tokens/src/**/*.test.ts",
    "forms-compat/src/**/*.spec.ts",
    "forms-compat/src/**/*.test.ts"
  ],
  "include": [
    "src/**/*.ts",
    "tokens/src/**/*.ts",
    "forms-compat/src/**/*.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
